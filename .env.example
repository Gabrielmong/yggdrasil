DATABASE_URL="postgresql://user:password@localhost:5432/yggdrasil"
AUTH_SECRET="generate-with-npx-auth-secret"
# Optional but recommended, especially in production: unauthenticated Google
# Books requests share a low, IP-based rate limit (easy to hit from a
# serverless deploy's shared IPs). Get a key at
# https://console.cloud.google.com/apis/credentials (restrict it to the
# Books API). Falls back to unauthenticated requests when unset.
GOOGLE_BOOKS_API_KEY=""
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
